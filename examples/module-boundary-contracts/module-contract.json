    "test/api/"
  ],
  "minimum_verifier": "npm test -- --run test/api",
  "widening_rule": "If the change needs src/ui/ or src/experiments/, stop and ask for a wider contract before editing.",
  "privacy": {
    "raw_source_included": false,
    "raw_prompt_included": false
  }
}
